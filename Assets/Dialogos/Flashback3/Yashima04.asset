  m_Script: {fileID: 11500000, guid: 3f1536ed0ed1fc34794803618148fe46, type: 3}
  m_Name: Yashima04
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  _lines:
  - _text: "A pe\xE7a cedeu com um estalo."
    _documentImage: {fileID: 0}
  - _text: "O alarme da simula\xE7\xE3o disparou, as luzes come\xE7aram a piscar
      e todo mundo correu para os postos."
    _documentImage: {fileID: 0}
  - _text: "Por alguns segundos, ningu\xE9m sabia se aquilo fazia parte do exerc\xEDcio
      ou se t\xEDnhamos um problema de verdade."
    _documentImage: {fileID: 0}
