%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3f1536ed0ed1fc34794803618148fe46, type: 3}
  m_Name: DialogoFlashback3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  _lines:
  - _text: "Antes de tocar em qualquer v\xE1lvula, precisamos confirmar o procedimento
      e avisar a sala de controle."
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: Em uma usina, desligar um sistema exige mais do que girar uma alavanca.
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: Entendido.
    _documentImage: {fileID: 0}
    _char: C.S
  - _text: "Ent\xE3o eu verifico a identifica\xE7\xE3o da v\xE1lvula, confirmo a
      autoriza\xE7\xE3o e acompanho os indicadores?"
    _documentImage: {fileID: 0}
    _char: C.S
  - _text: Exatamente.
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: "E s\xF3 seguimos o procedimento aprovado, passo a passo."
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: "NUNCA se for\xE7a uma v\xE1lvula, nem mesmo quando parece emperrada."
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: "Voc\xEA diz isso como quem aprendeu da maneira dif\xEDcil."
    _documentImage: {fileID: 0}
    _char: C.S
  - _text: Aprendi.
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: "Foi h\xE1 alguns anos, durante uma simula\xE7\xE3o."
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: "Eu estava treinando um novato, ele ficou nervoso quando a v\xE1lvula
      n\xE3o se moveu de primeira e fez for\xE7a demais."
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: E ela quebrou?
    _documentImage: {fileID: 0}
    _char: C.S
  - _text: "A pe\xE7a cedeu com um estalo."
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: "O alarme da simula\xE7\xE3o disparou, as luzes come\xE7aram a piscar
      e todo mundo correu para os postos."
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: "Por alguns segundos, ningu\xE9m sabia se aquilo fazia parte do exerc\xEDcio
      ou se t\xEDnhamos um problema de verdade."
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: Imagino o susto!!
    _documentImage: {fileID: 0}
    _char: C.S
  - _text: "Foi enorme. Paramos a simula\xE7\xE3o, isolamos a \xE1rea conforme o
      protocolo e chamamos a equipe respons\xE1vel."
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: "Felizmente, n\xE3o houve feridos nem risco para a usina. Mas aquela pe\xE7a
      danificada deixou uma li\xE7\xE3o que nunca esqueci:"
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: " N\xE3o improvise!!!!!!!!"
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: "Ent\xE3o hoje vamos fazer tudo com calma e dupla confirma\xE7\xE3o."
    _documentImage: {fileID: 0}
    _char: C.S
  - _text: Isso mesmo.
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: Primeiro, conferimos o procedimento.
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: Depois, a sala de controle confirma o estado do sistema.
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: Depois, a sala de controle confirma o estado do sistema.
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: "S\xF3 ent\xE3o a equipe autorizada executa a a\xE7\xE3o, sem pressa e
      sem for\xE7a."
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: "Certo. Seguran\xE7a primeiro e opera\xE7\xE3o depois."
    _documentImage: {fileID: 0}
    _char: C.S
  - _text: SEMPRE!!!!!!!!!!!!!!!
    _documentImage: {fileID: 0}
    _char: Yashima
