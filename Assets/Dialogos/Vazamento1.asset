  m_Name: Vazamento1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  _lines:
  - _text: "Consegui chegar no painel! Daqui, eu consigo fechar parte do vazamento
      de radia\xE7\xE3o!"
    _documentImage: {fileID: 0}
  - _text: '...

      ...'
    _documentImage: {fileID: 0}
  - _text: "A energia caiu, nada est\xE1 funcionando..."
    _documentImage: {fileID: 0}
  - _text: "N\xE3o me recordo bem do procedimento para for\xE7ar o desligamento."
    _documentImage: {fileID: 0}
  - _text: "Tinha algum m\xE9todo anal\xF3gico."
    _documentImage: {fileID: 0}
  - _text: "Eu n\xE3o precisava pegar uma v\xE1lvula?"
    _documentImage: {fileID: 0}
  - _text: Vou procurar por aqui.
    _documentImage: {fileID: 0}
