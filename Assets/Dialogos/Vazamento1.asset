  m_Script: {fileID: 11500000, guid: 3f1536ed0ed1fc34794803618148fe46, type: 3}
  m_Name: Vazamento1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  _lines:
  - _text: "Consegui chegar no painel! Daqui, eu consigo fechar parte do vazamento
      de radia\xE7\xE3o!"
    _documentImage: {fileID: 0}
  - _text: '...

      ...'
    _documentImage: {fileID: 0}
  - _text: "Nossa... que coisa... n\xE3o me lembro da combina\xE7\xE3o do painel."
    _documentImage: {fileID: 0}
  - _text: "Que droga, consegui chegar at\xE9 a sala de vazamento para nada..."
    _documentImage: {fileID: 0}
  - _text: "Acho que eu posso tentar investiar o lugar, ver se algo me d\xE1 um gatilho."
    _documentImage: {fileID: 0}
  - _text: "Preciso me lembrar, de qualquer coisa, qualquer coisa que possa ser \xFAtil!"
    _documentImage: {fileID: 0}
