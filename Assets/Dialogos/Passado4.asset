  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3f1536ed0ed1fc34794803618148fe46, type: 3}
  m_Name: Passado4
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  _lines:
  - _text: Nossa, odeio essas plataformas.
    _documentImage: {fileID: 0}
  - _text: "S\xF3 decorei que, ao entrar nelas, preciso interagir com elas, e selecionar
      um fus\xEDvel."
    _documentImage: {fileID: 0}
  - _text: O X move pelos lados.
    _documentImage: {fileID: 0}
  - _text: O Z move pela profundidade.
    _documentImage: {fileID: 0}
  - _text: E o Y move pela altura.
    _documentImage: {fileID: 0}
  - _text: "Acho que s\xF3 me lembro que tinha o eixo Y aqui, mas deve ser o bastante."
    _documentImage: {fileID: 0}
  - _text: "Para selecionar seu fus\xEDvel, escolha eles com [A] e [D]. Ent\xE3o
      confirme com [E]!"
    _documentImage: {fileID: 0}
  - _text: De nada truta, sem deixar mais o chefe esperando, heim...
    _documentImage: {fileID: 0}
