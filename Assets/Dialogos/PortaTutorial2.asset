  _lines:
  - _text: "Voc\xEA tenta abrir a porta."
    _documentImage: {fileID: 0}
  - _text: Coloca a chave de acesso no leitor.
    _documentImage: {fileID: 0}
  - _text: A porta destranca.
    _documentImage: {fileID: 0}
  - _text: "Mas pelo visto os n\xEDveis de radia\xE7\xE3o est\xE3o muito fortes."
    _documentImage: {fileID: 0}
  - _text: "O leitor queima as componentes do cart\xE3o."
    _documentImage: {fileID: 0}
  - _text: Melhor jogar ele fora.
    _documentImage: {fileID: 0}
