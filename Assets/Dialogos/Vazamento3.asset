  _lines:
  - _text: "N\xE3o quero conversar hoje."
    _documentImage: {fileID: 0}
  - _text: "O caf\xE9 daqui estava aguado."
    _documentImage: {fileID: 0}
  - _text: "Est\xE3o economizando at\xE9 do caf\xE9? Que absurdo!"
    _documentImage: {fileID: 0}
  - _text: "Sem ele, n\xE3o tenho bateria social para suportar o dia."
    _documentImage: {fileID: 0}
