  m_Script: {fileID: 11500000, guid: 3f1536ed0ed1fc34794803618148fe46, type: 3}
  m_Name: Dialogo1 Completo
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  _lines:
  - _text: Bom dia, Mako-kun!
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: Bom dia, Yashima-san. Chegou cedo hoje.
    _documentImage: {fileID: 0}
    _char: "Mako, secret\xE1ria"
  - _text: "Tentei evitar o tr\xE2nsito. Funcionou\u2026 mais ou menos."
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: 'Pelo menos chegou inteiro. '
    _documentImage: {fileID: 0}
    _char: Mako
  - _text: "O caf\xE9 est\xE1 fresquinho, se quiser pegar antes de ir para o escrit\xF3rio."
    _documentImage: {fileID: 0}
    _char: Mako
  - _text: Obrigado, mas vou deixar para depois. Tenho algumas coisas para revisar.
    _documentImage: {fileID: 0}
    _char: Yashima
