  m_Script: {fileID: 11500000, guid: 3f1536ed0ed1fc34794803618148fe46, type: 3}
  m_Name: Dialogo3 Completo
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  _lines:
  - _text: Yashima-san, bom dia!
    _documentImage: {fileID: 0}
    _char: Mori, engenheira
  - _text: "Deixei o relat\xF3rio na sua mesa ontem."
    _documentImage: {fileID: 0}
    _char: Mori
  - _text: Bom dia, Mori-kun.
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: Vi, sim.
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: "Obrigado por organizar tudo \u2014 vou conferir assim que chegar."
    _documentImage: {fileID: 0}
    _char: Yashima
  - _text: "Ent\xE3o est\xE1 todo mundo avisado."
    _documentImage: {fileID: 0}
    _char: Mori
  - _text: "Boa sorte com os relat\xF3rios!"
    _documentImage: {fileID: 0}
    _char: Mori
  - _text: "Obrigado. Bom trabalho para voc\xEAs!\r\n"
    _documentImage: {fileID: 0}
    _char: Yashima
