  m_Script: {fileID: 11500000, guid: 3f1536ed0ed1fc34794803618148fe46, type: 3}
  m_Name: Terminal falha
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  _lines:
  - _text: "Nossa, consegui chegar at\xE9 aqui!"
    _documentImage: {fileID: 0}
    _char: 
  - _text: "N\xE3o achei que daria certo..."
    _documentImage: {fileID: 0}
    _char: 
  - _text: Mas no fim, deu tempo. Vou conseguir salvar todos.
    _documentImage: {fileID: 0}
    _char: 
  - _text: "Hm... A energia est\xE1 desativada..."
    _documentImage: {fileID: 0}
    _char: 
  - _text: "Acho que a radia\xE7\xE3o est\xE1 muito forte nessa zona."
    _documentImage: {fileID: 0}
    _char: 
  - _text: "Vou precisar dar um jeito de diminuir a press\xE3o"
    _documentImage: {fileID: 0}
    _char: 
  - _text: "Para conseguir for\xE7ar o uso dos geradores."
    _documentImage: {fileID: 0}
    _char: 
  - _text: "Vou procurar por essa instala\xE7\xE3o por v\xE1lvulas, para fechar a
      press\xE3o."
    _documentImage: {fileID: 0}
    _char: 
  - _text: "Acho que 4 v\xE1lvulas ser\xE3o o suficiente."
    _documentImage: {fileID: 0}
    _char: 
