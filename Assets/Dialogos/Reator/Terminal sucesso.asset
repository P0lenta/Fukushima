  m_Script: {fileID: 11500000, guid: 3f1536ed0ed1fc34794803618148fe46, type: 3}
  m_Name: Terminal sucesso
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  _lines:
  - _text: "Nossa, consegui chegar at\xE9 aqui!"
    _documentImage: {fileID: 0}
    _char: 
  - _text: "N\xE3o achei que daria certo..."
    _documentImage: {fileID: 0}
    _char: 
  - _text: Mas no fim, deu tempo. Vou conseguir salvar todos.
    _documentImage: {fileID: 0}
    _char: 
  - _text: "Hm... A energia est\xE1 desativada..."
    _documentImage: {fileID: 0}
    _char: 
  - _text: "Ainda bem que as v\xE1lvulas j\xE1 foram ativadas."
    _documentImage: {fileID: 0}
    _char: 
  - _text: "Vou conseguir ligar a energia de emerg\xEAncia..."
    _documentImage: {fileID: 0}
    _char: 
  - _text: Vamos ver...
    _documentImage: {fileID: 21300000, guid: 45df4942f9a0c99468e4130b4f6457eb, type: 3}
    _char: 
  - _text: ...
    _documentImage: {fileID: 21300000, guid: 45df4942f9a0c99468e4130b4f6457eb, type: 3}
    _char: 
  - _text: 'Ligou! '
    _documentImage: {fileID: 21300000, guid: cbc7f8ae57682a340b70665cb34d2da6, type: 3}
    _char: 
  - _text: "Agora s\xF3 preciso fechar o vazamento."
    _documentImage: {fileID: 21300000, guid: cbc7f8ae57682a340b70665cb34d2da6, type: 3}
    _char: 
  - _text: Maravilha!
    _documentImage: {fileID: 21300000, guid: 8aa195471b87e9e469e4be120122c348, type: 3}
    _char: 
  - _text: Vazamento contido!
    _documentImage: {fileID: 21300000, guid: 8aa195471b87e9e469e4be120122c348, type: 3}
    _char: 
  - _text: Ainda bem que deu certo.
    _documentImage: {fileID: 0}
    _char: 
  - _text: "Vou conseguir deixar esse lugar para tr\xE1s."
    _documentImage: {fileID: 0}
    _char: 
  - _text: Parte do que foi meu passado se foi... mas pude salvar o restante do meu
      futuro.
    _documentImage: {fileID: 0}
    _char: 
