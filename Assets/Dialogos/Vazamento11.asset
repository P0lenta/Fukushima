  _lines:
  - _text: "Voc\xEA consegue colocar a v\xE1lvula no terminal."
    _documentImage: {fileID: 0}
    _char: 
  - _text: O sistema parece funcionar.
    _documentImage: {fileID: 21300000, guid: 9ca7400e85bdd9640a21153be648c460, type: 3}
    _char: 
  - _text: "S\xF3 falta girar a v\xE1lvula."
    _documentImage: {fileID: 21300000, guid: 9ca7400e85bdd9640a21153be648c460, type: 3}
    _char: 
  - _text: E...
    _documentImage: {fileID: 21300000, guid: 9ca7400e85bdd9640a21153be648c460, type: 3}
    _char: 
  - _text: Parece estar carregando...
    _documentImage: {fileID: 21300000, guid: 23cedeb28340f3e4cba39c92a1927d64, type: 3}
    _char: 
  - _text: ...
    _documentImage: {fileID: 21300000, guid: 23cedeb28340f3e4cba39c92a1927d64, type: 3}
    _char: 
  - _text: ...?
    _documentImage: {fileID: 21300000, guid: 6830a7e9f9c10a144b423398aba4c2dc, type: 3}
    _char: 
  - _text: Sucesso!
    _documentImage: {fileID: 21300000, guid: 357a11597ec57594a97622e2b4d92057, type: 3}
    _char: 
  - _text: Vazamento 01 contido!
    _documentImage: {fileID: 21300000, guid: 357a11597ec57594a97622e2b4d92057, type: 3}
    _char: 
  - _text: "Agora posso avan\xE7ar para o pr\xF3ximo galp\xE3o!"
    _documentImage: {fileID: 0}
    _char: 
  - _text: "Tenho que fechar o pr\xF3ximo vazamento"
    _documentImage: {fileID: 0}
    _char: 
