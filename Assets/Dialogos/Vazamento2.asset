  m_Script: {fileID: 11500000, guid: 3f1536ed0ed1fc34794803618148fe46, type: 3}
  m_Name: Vazamento2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  _lines:
  - _text: Oi, tudo bem?
    _documentImage: {fileID: 0}
  - _text: "Chegou atrasado de novo... eu mudaria essa rota de trem, ela \xE9 bem
      imprevis\xEDvel."
    _documentImage: {fileID: 0}
  - _text: "Ent\xE3o... os chefes decidiram cortar a verba do setor de novo."
    _documentImage: {fileID: 0}
  - _text: "Agora n\xE3o possu\xEDmos mais um associado para cuidar da sala de vazamento. "
    _documentImage: {fileID: 0}
  - _text: "\xC9 nossa responsabilidade agora... cada um por s\xED, n\xE9?"
    _documentImage: {fileID: 0}
