  _lines:
  - _text: "Meu arm\xE1rio de sempre."
    _documentImage: {fileID: 0}
    _char: 
  - _text: "\xC9 bom aproveitar para pegar meus materiais."
    _documentImage: {fileID: 0}
    _char: 
  - _text: "Agora que a empresa n\xE3o paga mais pelas ferramentas..."
    _documentImage: {fileID: 0}
    _char: 
  - _text: "\xC9 bom garantir que os meus estejam em \xF3timo estado."
    _documentImage: {fileID: 0}
    _char: 
  - _text: Sinto que o dia vai ser cheio hoje.
    _documentImage: {fileID: 0}
    _char: 
