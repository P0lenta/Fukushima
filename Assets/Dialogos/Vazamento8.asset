  m_Script: {fileID: 11500000, guid: 3f1536ed0ed1fc34794803618148fe46, type: 3}
  m_Name: Vazamento8
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  _lines:
  - _text: Fujimaro.
    _documentImage: {fileID: 0}
  - _text: "Estou muito contente com a not\xEDcia."
    _documentImage: {fileID: 0}
  - _text: De verdade.
    _documentImage: {fileID: 0}
  - _text: "Ainda n\xE3o contei para a equipe que vai ter um filho, mas logo, logo
      iremos comemorar!"
    _documentImage: {fileID: 0}
  - _text: Aceita sair para beber essa noite? Por minha conta.
    _documentImage: {fileID: 0}
  - _text: "E por sinal... n\xE3o sei se te falaram, mas agora n\xF3s tamb\xE9m cuidamos
      dessa sala."
    _documentImage: {fileID: 0}
  - _text: Os controles de vazamento...
    _documentImage: {fileID: 0}
  - _text: "Meio que podemos impedir que a radia\xE7\xE3o desse lugar vaze para todo
      lado."
    _documentImage: {fileID: 0}
  - _text: "Eu n\xE3o consegui pensar em uma boa senha para colocar no programa."
    _documentImage: {fileID: 0}
  - _text: "Ent\xE3o tive uma ideia brilhante!"
    _documentImage: {fileID: 0}
  - _text: Que tal colocar o nome do seu filho?
    _documentImage: {fileID: 0}
  - _text: "\xC9 um jesto simb\xF3lico de hoje: "
    _documentImage: {fileID: 0}
  - _text: "O dia em que todos beberam at\xE9 cair "
    _documentImage: {fileID: 0}
  - _text: Gritando "Fujimaro papai, Fujimaro papai"
    _documentImage: {fileID: 0}
  - _text: "E coisas bem mais expl\xEDcitas que n\xE3o posso comentar em hor\xE1rio
      de servi\xE7o, haha."
    _documentImage: {fileID: 0}
