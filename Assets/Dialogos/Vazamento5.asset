  m_Script: {fileID: 11500000, guid: 3f1536ed0ed1fc34794803618148fe46, type: 3}
  m_Name: Vazamento5
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  _lines:
  - _text: "Por que estamos t\xE3o perfeitamente enfileirados assim?"
    _documentImage: {fileID: 0}
  - _text: Ora, ordens da chefia.
    _documentImage: {fileID: 0}
  - _text: "As cadeiras s\xE3o para o governo... eles tem que ver se as coisas t\xE3o
      boas."
    _documentImage: {fileID: 0}
  - _text: Se a gente sentar muito nelas, tem a chance delas ficarem gastas.
    _documentImage: {fileID: 0}
  - _text: "E a empresa n\xE3o gostaria nada de receber um pedido de troca."
    _documentImage: {fileID: 0}
  - _text: "Ent\xE3o ficamos aqui"
    _documentImage: {fileID: 0}
  - _text: Parados
    _documentImage: {fileID: 0}
  - _text: "Em p\xE9"
    _documentImage: {fileID: 0}
  - _text: Em uma fileira perfeita.
    _documentImage: {fileID: 0}
  - _text: "Se junte a n\xF3s, qualquer hora!"
    _documentImage: {fileID: 0}
  - _text: "Acho que tem espa\xE7o para voc\xEA perto da porta."
    _documentImage: {fileID: 0}
