  m_Name: Porta Destrancada
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  _lines:
  - _text: "Achei o cart\xE3o de acesso."
    _documentImage: {fileID: 0}
    _char: 
  - _text: Agora consigo abrir a porta.
    _documentImage: {fileID: 0}
    _char: 
  - _text: ...
    _documentImage: {fileID: 0}
    _char: 
  - _text: Ela se destrancou.
    _documentImage: {fileID: 0}
    _char: 
  - _text: "Mas os chips do cart\xE3o queimaram de novo."
    _documentImage: {fileID: 0}
    _char: 
  - _text: "Acho que vou ter que descartar todo cart\xE3o, ap\xF3s o uso."
    _documentImage: {fileID: 0}
    _char: 
  - _text: "Espero que tenham muitos cart\xF5es espalhados pela usina."
    _documentImage: {fileID: 0}
    _char: 
  - _text: "Agora \xE9 hora de avan\xE7ar!"
    _documentImage: {fileID: 0}
    _char: 
