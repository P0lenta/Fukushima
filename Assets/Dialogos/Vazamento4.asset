  _lines:
  - _text: Opa, conseguiu chegar!
    _documentImage: {fileID: 0}
  - _text: Que felicidades!!!
    _documentImage: {fileID: 0}
  - _text: Ouvi que vai ser pai daqui a pouco.
    _documentImage: {fileID: 0}
  - _text: "Isso \xE9 maravilhoso!"
    _documentImage: {fileID: 0}
  - _text: "Mas n\xE3o pense em se arriscar por a\xED, n\xE9?"
    _documentImage: {fileID: 0}
  - _text: "Voc\xEA precisa ficar presente para sua fam\xEDlia, sem se colocar em
      perigo."
    _documentImage: {fileID: 0}
